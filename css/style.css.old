/* =========================================
   RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--bg);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
}

img {
    display: block;
    max-width: 100%;
}

a {
    color: inherit;
    text-decoration: none;
}

a,
button {
    -webkit-tap-highlight-color: transparent;
}


/* =========================================
   VARIABLES
========================================= */

:root {
    --bg: #11100f;
    --bg-light: #181614;
    --bg-card: #201d1a;

    --text: #f3f0eb;
    --text-muted: #aaa39a;

    --accent: #9b542f;
    --accent-light: #b56a43;
    --accent-dark: #743c24;

    --border: rgba(255, 255, 255, 0.10);
    --border-strong: rgba(255, 255, 255, 0.18);

    --container: 1200px;

    --space-xs: 8px;
    --space-sm: 12px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 32px;
    --space-2xl: 48px;
    --space-3xl: 64px;
    --space-4xl: 80px;
}


/* =========================================
   GENERAL
========================================= */

.container {
    width: min(100% - 48px, var(--container));
    margin-inline: auto;
}

.section {
    padding: var(--space-4xl) 0;
}

.eyebrow {
    color: var(--accent-light);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

h1,
h2,
h3 {
    line-height: 1.1;
    font-weight: 500;
}

h1 {
    letter-spacing: -0.03em;
}

h2 {
    font-size: clamp(2.2rem, 4vw, 4rem);
    letter-spacing: -0.025em;
}

h3 {
    letter-spacing: -0.01em;
}

p {
    color: var(--text-muted);
}


/* =========================================
   ACCESSIBILITY / FOCUS
========================================= */

a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
    outline: 2px solid var(--accent-light);
    outline-offset: 3px;
}


/* =========================================
   HEADER
========================================= */

.site-header {
    position: absolute;
    top: 0;
    left: 0;

    width: 100%;

    z-index: 20;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);

    background: rgba(10, 9, 8, 0.88);
}

.header-inner {
    height: 88px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
}

.header-brand-name {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);

    color: var(--color-text);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
}

.header-brand-name:hover {
    color: var(--color-primary);
}

.logo {
    display: flex;
    align-items: center;
}

.logo img {
    width: 90px;
    height: 90px;

    object-fit: contain;
}

.desktop-nav {
    display: flex;
    align-items: center;

    gap: 32px;

    margin-left: auto;
    margin-right: 32px;
}

.desktop-nav a {
    color: #ddd7d0;

    font-size: 0.9rem;

    transition: color 180ms ease;
}

.desktop-nav a:hover {
    color: var(--accent-light);
}

.header-menu-btn {
    min-height: 44px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 18px;

    border: 1px solid var(--accent);

    color: #fff;

    font-size: 0.85rem;

    line-height: 1;

    transition:
        background-color 180ms ease,
        color 180ms ease,
        border-color 180ms ease;
}

.header-menu-btn:hover {
    background: var(--accent);
}


/* =========================================
   HERO
========================================= */

.hero {
    position: relative;

    min-height: 760px;

    display: flex;
    align-items: center;

    overflow: hidden;
}

.hero-image {
    position: absolute;
    inset: 0;
}

.hero-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    filter: saturate(0.85);
}

.hero-overlay {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(10, 9, 8, 0.95) 0%,
            rgba(10, 9, 8, 0.75) 42%,
            rgba(10, 9, 8, 0.30) 100%
        );
}

.hero-content {
    position: relative;

    z-index: 2;

    max-width: 650px;

    padding-top: 64px;
}

.hero h1 {
    margin-top: var(--space-md);

    font-size: clamp(2.8rem, 5vw, 4.8rem);
}

.hero-text {
    max-width: 480px;

    margin-top: var(--space-lg);

    font-size: 1.05rem;
}

.hero-actions {
    display: flex;

    gap: var(--space-sm);

    margin-top: var(--space-xl);
}


/* =========================================
   BUTTONS
========================================= */

.btn {
    min-height: 46px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 22px;

    border-radius: 4px;

    font-size: 0.85rem;
    font-weight: 700;

    transition:
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        transform 180ms ease;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn-primary {
    background: var(--accent);

    border: 1px solid var(--accent);

    color: #fff;
}

.btn-primary:hover {
    background: var(--accent-light);

    border-color: var(--accent-light);
}

.btn-outline {
    border: 1px solid rgba(255, 255, 255, 0.35);

    color: #fff;
}

.btn-outline:hover {
    border-color: #fff;

    background: rgba(255, 255, 255, 0.08);
}


/* =========================================
   INTRO
========================================= */

.intro {
    background: var(--bg);
}

.intro-content {
    max-width: 780px;

    margin-inline: auto;

    text-align: center;
}

.intro-content .eyebrow {
    margin-bottom: 18px;
}

.intro-content p:last-child {
    max-width: 620px;

    margin: var(--space-lg) auto 0;

    font-size: 1.05rem;
}


/* =========================================
   SECTION HEADING
========================================= */

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: var(--space-3xl);

    margin-bottom: var(--space-2xl);
}

.section-heading > p {
    max-width: 360px;
}

.section-heading h2 {
    margin-top: var(--space-sm);
}


/* =========================================
   SPECIALITÀ
========================================= */

.specialita {
    background: var(--bg-light);
}

.specialita-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: var(--space-lg);
}

.specialita-card {
    overflow: hidden;

    background: var(--bg-card);

    border: 1px solid var(--border);
    border-radius: 4px;
}

.specialita-image {
    aspect-ratio: 1 / 1;

    overflow: hidden;
}

.specialita-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 400ms ease;
}

.specialita-card:hover .specialita-image img {
    transform: scale(1.03);
}

.specialita-content {
    padding: 30px;
}

.card-label {
    color: var(--accent-light);

    font-size: 0.68rem;
    font-weight: 700;

    letter-spacing: 0.15em;
}

.specialita-content h3 {
    margin-top: var(--space-xs);

    font-size: 2rem;
}

.specialita-content p {
    margin-top: var(--space-sm);
}

.specialita-dark {
    background: #151311;
}

.specialita-placeholder {
    aspect-ratio: 1 / 1;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    background:
        radial-gradient(
            circle at center,
            rgba(155, 84, 47, 0.22),
            transparent 55%
        );

    border-bottom: 1px solid var(--border);
}

.specialita-placeholder span {
    color: var(--accent-light);

    font-size: 4rem;
    font-weight: 700;

    letter-spacing: 0.12em;
}

.specialita-placeholder small {
    margin-top: var(--space-xs);

    color: var(--text-muted);
}

.text-link {
    display: inline-block;

    margin-top: 20px;

    color: var(--accent-light);

    font-size: 0.85rem;

    transition: color 180ms ease;
}

.text-link:hover {
    color: #fff;
}


/* =========================================
   IL LOCALE
========================================= */

.locale {
    background: var(--bg);
}

.locale-grid {
    display: grid;

    grid-template-columns: 1.15fr 0.85fr;

    gap: var(--space-4xl);

    align-items: center;
}

.locale-image {
    overflow: hidden;
}

.locale-image img {
    width: 100%;

    aspect-ratio: 16 / 10;

    object-fit: cover;
}

.locale-content h2 {
    margin-top: var(--space-sm);
}

.locale-content > p {
    max-width: 480px;

    margin-top: var(--space-lg);
}

.activities {
    margin-top: var(--space-2xl);
}

.activity {
    padding: 20px 0;

    border-top: 1px solid var(--border);
}

.activity:last-child {
    border-bottom: 1px solid var(--border);
}

.activity h3 {
    font-size: 1.15rem;
}

.activity p {
    margin-top: 4px;

    font-size: 0.85rem;
}


/* =========================================
   MENU
========================================= */

.menu-preview {
    background: var(--bg-light);
}

.menu-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: var(--space-4xl);
}

.menu-column-title {
    padding-bottom: var(--space-sm);

    border-bottom: 1px solid var(--accent);
}

.menu-column-title span {
    color: var(--accent-light);

    font-size: 0.72rem;
    font-weight: 700;

    letter-spacing: 0.15em;
}

.menu-category {
    padding: var(--space-xl) 0;

    border-bottom: 1px solid var(--border);
}

.menu-category h3 {
    margin-bottom: 20px;

    color: #fff;

    font-size: 1.4rem;
}

.menu-item,
.beer-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    gap: var(--space-lg);

    padding: 13px 0;
}

.menu-item strong,
.beer-item strong {
    font-size: 0.9rem;
    font-weight: 500;
}

.menu-item > span {
    flex-shrink: 0;

    color: var(--accent-light);

    font-size: 0.85rem;
}

.menu-item small {
    display: block;

    max-width: 340px;

    margin-top: 3px;

    color: var(--text-muted);

    font-size: 0.75rem;
}

.beer-prices {
    display: flex;

    flex-shrink: 0;

    gap: 20px;

    color: var(--accent-light);

    font-size: 0.82rem;
}

.menu-cta {
    margin-top: var(--space-2xl);

    text-align: center;
}


/* =========================================
   GALLERY
========================================= */

.gallery {
    background: var(--bg);
}

.gallery-grid {
    display: grid;

    grid-template-columns: 2fr 1fr 1fr;

    gap: 15px;
}

.gallery-item {
    min-height: 350px;

    overflow: hidden;
}

.gallery-item img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 400ms ease;
}

.gallery-item:hover img {
    transform: scale(1.03);
}

.gallery-large {
    min-height: 500px;
}


/* =========================================
   SOCIAL
========================================= */

.social {
    background: var(--accent-dark);
}

.social-inner {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: var(--space-4xl);

    align-items: center;
}

.social h2 {
    margin-top: var(--space-sm);
}

.social-links {
    display: flex;
    flex-direction: column;

    border-top: 1px solid rgba(255, 255, 255, 0.20);
}

.social-links a {
    display: block;

    padding: 18px 0;

    border-bottom: 1px solid rgba(255, 255, 255, 0.20);

    font-size: 1rem;

    transition:
        color 180ms ease,
        padding-left 180ms ease;
}

.social-links a:hover {
    padding-left: 4px;

    color: #fff;
}


/* =========================================
   CONTATTI
========================================= */

.contacts {
    background: var(--bg-light);
}

.contacts-header {
    margin-bottom: var(--space-2xl);
}

.contacts-header h2 {
    margin-top: var(--space-sm);
}

.contacts-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}

.contact-box {
    min-height: 180px;

    padding: 30px;

    border-right: 1px solid var(--border);
}

.contact-box:last-child {
    border-right: none;
}

.contact-label {
    color: var(--accent-light);

    font-size: 0.68rem;
    font-weight: 700;

    letter-spacing: 0.15em;
}

.contact-box p,
.contact-box a {
    display: block;

    margin-top: 15px;

    color: #ddd7d0;

    font-size: 0.9rem;
}

.contact-box a:hover {
    color: var(--accent-light);
}


/* =========================================
   GOOGLE MAPS
========================================= */

.map-container {
    width: 100%;

    margin-top: var(--space-lg);

    overflow: hidden;

    border: 1px solid var(--border);
    border-radius: 4px;
}

.map-container iframe {
    display: block;

    width: 100%;

    min-height: 350px;

    border: 0;
}


/* =========================================
   FOOTER
========================================= */

.site-footer {
    background: #0b0a09;

    border-top: 1px solid var(--border);
}

.footer-inner {
    min-height: 180px;

    display: grid;

    grid-template-columns: 1fr auto auto;

    align-items: center;

    gap: var(--space-2xl);
}

.footer-brand {
    display: flex;
    align-items: center;
    gap: 20px;
}

.footer-brand img {
    width: 64px;
    height: auto;
    flex-shrink: 0;
}

.footer-brand p {
    margin-top: var(--space-xs);

    font-size: 0.75rem;
}

.footer-brand-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
}

.footer-links {
    display: flex;

    gap: var(--space-lg);

    font-size: 0.8rem;
}

.footer-links a {
    transition: color 180ms ease;
}

.footer-links a:hover {
    color: var(--accent-light);
}

.copyright {
    font-size: 0.7rem;
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 900px) {

    .section {
        padding: var(--space-4xl) 0;
    }


    /* HEADER */

    .desktop-nav {
        display: none;
    }


    /* HERO */

    .hero {
        min-height: 700px;
    }

    .hero-content {
        max-width: 600px;
    }


    /* TITOLI */

    .section-heading {
        flex-direction: column;
        align-items: flex-start;

        gap: var(--space-sm);
    }


    /* SPECIALITÀ */

    .specialita-grid {
        grid-template-columns: 1fr;
    }


    /* LOCALE */

    .locale-grid {
        grid-template-columns: 1fr;

        gap: var(--space-2xl);
    }


    /* MENU */

    .menu-grid {
        grid-template-columns: 1fr;

        gap: var(--space-2xl);
    }


    /* GALLERY */

    .gallery-grid {
        grid-template-columns: 1fr 1fr;
    }

    .gallery-large {
        grid-column: span 2;

        min-height: 400px;
    }


    /* SOCIAL */

    .social-inner {
        grid-template-columns: 1fr;

        gap: var(--space-2xl);
    }


    /* CONTATTI */

    .contacts-grid {
        grid-template-columns: 1fr;
    }

    .contact-box {
        min-height: auto;

        border-right: none;
        border-bottom: 1px solid var(--border);
    }

    .contact-box:last-child {
        border-bottom: none;
    }


    /* FOOTER */

    .footer-inner {
        grid-template-columns: 1fr;

        gap: var(--space-lg);

        padding: var(--space-2xl) 0;
    }
}


/* =========================================
   MOBILE
========================================= */

/* =========================================
   MOBILE
========================================= */

@media (max-width: 600px) {

    .container {
        width: min(100% - 32px, var(--container));
    }


    /* =========================================
       GENERAL
    ========================================= */

    .section {
        padding: 64px 0;
    }


    /* =========================================
       HEADER
    ========================================= */

    .site-header {
        height: 78px;
        min-height: 78px;
    }

    .header-inner {
        width: min(100% - 24px, 1200px);

        height: 78px;
        min-height: 78px;

        display: grid;
        grid-template-columns: 1fr auto 1fr;

        align-items: center;

        gap: 8px;
        position: relative;
    }


    /* LOGO */

    .logo {
        justify-self: start;

        display: flex;
        align-items: center;

        height: 100%;
    }

    .logo img {
        display: block;

        width: 72px;
        height: 72px;

        object-fit: contain;

        opacity: 1;

        filter:
            brightness(1.4)
            saturate(1.15);
    }


    /* NOME CENTRALE */

    .header-brand-name {
        position: static;

        transform: none;

        justify-self: center;

        color: var(--text);

        font-size: 0.95rem;
        font-weight: 700;

        letter-spacing: 0.08em;
        line-height: 1;

        white-space: nowrap;
        text-decoration: none;
    }

    .header-brand-name:hover {
        color: var(--text);
    }


    /* NAVIGAZIONE DESKTOP */

    .desktop-nav {
        display: none;
    }


    /* PULSANTE MENU */

    .header-menu-btn {
        justify-self: end;

        min-height: 44px;

        padding: 0 12px;

        font-size: 0.85rem;

        white-space: nowrap;
    }


    /* =========================================
       HERO
    ========================================= */

    .hero {
        min-height: 680px;

        display: flex;
        align-items: flex-end;
    }

    .hero-image img {
        object-position: center;
    }

    .hero-overlay {
        background:
            linear-gradient(
                180deg,
                rgba(10, 9, 8, 0.20) 0%,
                rgba(10, 9, 8, 0.65) 50%,
                rgba(10, 9, 8, 0.98) 100%
            );
    }


    /*
       IMPORTANTE:

       La hero usa align-items: flex-end.
       Quindi padding-bottom controlla
       quanto il contenuto viene spostato
       verso l'alto.
    */

    .hero-content {
        padding-top: 0;
        padding-bottom: 100px;
    }


    .hero h1 {
        font-size: clamp(2.7rem, 12vw, 3.5rem);
    }

    .hero-text {
        font-size: 0.95rem;
    }

    .hero-actions {
        flex-direction: column;

        margin-top: var(--space-lg);
    }


    /* =========================================
       BUTTON
    ========================================= */

    .btn {
        width: 100%;
    }


    /* =========================================
       TITOLI
    ========================================= */

    h2 {
        font-size: 2.4rem;
    }


    /* =========================================
       SPECIALITÀ
    ========================================= */

    .specialita-content {
        padding: var(--space-lg);
    }

    .specialita-placeholder span {
        font-size: 3rem;
    }


    /* =========================================
       LOCALE
    ========================================= */

    .locale-image img {
        aspect-ratio: 4 / 3;
    }


    /* =========================================
       MENU
    ========================================= */

    .menu-item,
    .beer-item {
        gap: var(--space-sm);
    }

    .beer-prices {
        gap: var(--space-sm);
    }


    /* =========================================
       GALLERY
    ========================================= */

    .gallery-grid {
        grid-template-columns: 1fr;
    }

    .gallery-large {
        grid-column: auto;

        min-height: 300px;
    }

    .gallery-item {
        min-height: 300px;
    }


    /* =========================================
       SOCIAL
    ========================================= */

    .social h2 {
        font-size: 2.5rem;
    }


    /* =========================================
       CONTATTI
    ========================================= */

    .contact-box {
        padding: var(--space-lg) 0;
    }


    /* =========================================
       MAPPA
    ========================================= */

    .map-container iframe {
        min-height: 280px;
    }


    /* =========================================
       FOOTER
    ========================================= */

    .footer-links {
        flex-wrap: wrap;
    }

    .footer-brand {
        align-items: flex-start;
    }

    .footer-brand img {
        width: 52px;
    }

}


/* =========================================
   NOTA MENU
========================================= */

.menu-note {
    margin-top: 24px;
    text-align: center;
}

.menu-note p {
    margin: 0;

    color: var(--color-text-muted);

    font-size: 0.875rem;
}


/* =========================================
   MAPPA
========================================= */

.map-container {
    margin-top: 48px;

    overflow: hidden;

    border: 1px solid var(--color-border);
    border-radius: 8px;
}

.map-container iframe {
    display: block;

    width: 100%;
    min-height: 400px;

    border: 0;
}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}